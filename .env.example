# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/y_tu_que_compras"

# better-auth (https://www.better-auth.com/docs/installation#configure-env-variables)
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:5173"

# Envio de email por SMTP (Oracle Cloud Email Delivery), para el codigo OTP
# del login y las invitaciones a la familia. En desarrollo/test no se envia
# ningun correo real: los emails quedan capturados en el log.
# Nótese el typo SMPT_ en vez de SMTP_: es intencionado, así están
# desplegadas las variables en producción.
SMTP_HOST=
SMPT_AUTH_USER=
SMPT_AUTH_PASS=
SMPT_SENDER=

# GitHub Packages token (classic PAT with read:packages) to install
# @callepuzzle/* and @zytera/* packages (https://github.com/settings/tokens)
NPM_TOKEN=""
