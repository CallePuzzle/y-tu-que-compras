// Base schema for better-auth (https://better-auth.com/docs/concepts/database#prisma)
// Regenerate with `npx @better-auth/cli generate` when adding auth plugins.

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]

  // Grants/denies recibidos (userId) y concedidos/denegados por el usuario
  // (grantedBy/deniedBy). Los recibidos mueren con el usuario; los firmados
  // por él sobreviven (Restrict): un permiso no deja de existir porque quien
  // lo concedió borre su cuenta.
  permissionGrants       PermissionGrant[] @relation("PermissionGrantsReceived")
  permissionGrantsGiven  PermissionGrant[] @relation("PermissionGrantsGiven")
  permissionDenies       PermissionDeny[]  @relation("PermissionDeniesReceived")
  permissionDeniesIssued PermissionDeny[]  @relation("PermissionDeniesIssued")
  invitations            Invitation[]
  purchases              PurchaseRecord[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Almacén del rate limit de better-auth (`rateLimit.storage: 'database'`).
model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ============================================================================
// Plugin @zytera/better-auth-tenancy (familia = organization).
//
// Los modelos replican el `schema` que declara el plugin en el servidor; el
// nombre Prisma es el del modelo better-auth y `@@map` usa la misma clave que
// usa el adaptador para buscar la tabla. Los campos polimórficos
// (contextType/contextId, parentType/parentId) no pueden ser FK en Prisma:
// quedan como columnas planas con índice. El resto de FKs sigue el esquema
// drizzle del servicio Zytera, que lleva este plugin en producción.
// ============================================================================

// Familia: raíz de la jerarquía. No tiene FK: los ids de contextos viajan como
// columnas planas (contextId) en role/member/invitation/grant/deny.
//
// Las relaciones `lists`, `purchases` y `pantryItems` son de la app (no del
// plugin, que las ignora): al borrar la familia mueren con ella sus listas de
// la compra (Cascade en List), su historial de compras (Cascade en
// PurchaseRecord) y su despensa (Cascade en PantryItem).
model Organization {
  id          String           @id
  name        String
  slug        String           @unique
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lists       List[]
  purchases   PurchaseRecord[]
  pantryItems PantryItem[]

  @@map("organization")
}

// Agrupación hija (hoy sin uso: una familia no tiene subgrupos). Se declara
// porque el plugin expone sus endpoints contra este modelo.
model Team {
  id         String   @id
  parentType String
  parentId   String
  name       String
  slug       String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([parentType, parentId])
  @@map("team")
}

// Catálogo de permisos `categoria:operacion`. Los roles referencian statements
// por su id aunque no estén catalogados (el chequeo es un cruce por cadena), así
// que la tabla puede quedarse vacía; existe para los endpoints del plugin.
model Statement {
  id           String                 @id
  category     String
  operation    String
  createdAt    DateTime               @default(now())
  translations StatementTranslation[]

  @@map("statement")
}

model StatementTranslation {
  id          String    @id
  statementId String
  statement   Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  description String?
  createdAt   DateTime  @default(now())

  @@unique([statementId, locale])
  @@map("statementTranslation")
}

// Rol de una familia (contextType = 'organization'). `name` es el identificador
// estable ('admin'/'member'); el nombre visible vive en RoleTranslation.
model Role {
  id           String            @id
  contextType  String
  contextId    String
  name         String
  description  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  statements   RoleStatement[]
  translations RoleTranslation[]
  members      Member[]

  @@index([contextType, contextId])
  @@map("role")
}

// Statements del rol. `statementId` sin FK a propósito: los roles llevan ids de
// statements propios de la app (`member:invite`, …) que no están en el catálogo
// `statement`, y una FK los obligaría a sembrarlo antes de crear cada familia.
model RoleStatement {
  id          String   @id
  roleId      String
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  statementId String
  createdAt   DateTime @default(now())

  @@index([roleId])
  @@index([statementId])
  @@map("roleStatement")
}

model RoleTranslation {
  id          String   @id
  roleId      String
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  description String?
  createdAt   DateTime @default(now())

  @@unique([roleId, locale])
  @@map("roleTranslation")
}

// Miembro de una familia (o, en el futuro, de un Team). `roleId` opcional: el
// rol por defecto se asigna al entrar (issue #59) y `SetNull` mantiene la
// pertenencia si el rol desaparece.
//
// La pertenencia es única por contexto: `member/add` del plugin no comprueba
// duplicados (solo `limits`), y sin esta restricción un admin podría añadir dos veces
// al mismo usuario (saldría duplicado en los listados de miembros). El precio:
// un duplicado lanza P2002 (la UI lo traduce a error genérico).
model Member {
  id          String   @id
  contextType String
  contextId   String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String?
  role        Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([contextType, contextId, userId])
  @@index([userId])
  @@index([contextType, contextId])
  @@map("member")
}

// Overrides puntuales sobre el rol (deny-first policy). `statementId` plano por
// lo mismo que en RoleStatement.
model PermissionGrant {
  id            String    @id
  userId        String
  user          User      @relation("PermissionGrantsReceived", fields: [userId], references: [id], onDelete: Cascade)
  statementId   String
  contextType   String
  contextId     String
  expiresAt     DateTime?
  grantedBy     String
  grantedByUser User      @relation("PermissionGrantsGiven", fields: [grantedBy], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([contextType, contextId])
  @@map("permissionGrant")
}

model PermissionDeny {
  id           String   @id
  userId       String
  user         User     @relation("PermissionDeniesReceived", fields: [userId], references: [id], onDelete: Cascade)
  statementId  String
  contextType  String
  contextId    String
  deniedBy     String
  deniedByUser User     @relation("PermissionDeniesIssued", fields: [deniedBy], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([contextType, contextId])
  @@map("permissionDeny")
}

// Invitación a una familia. `roleId` sin FK: el plugin no valida su existencia
// (la resolución de rol en lectura es tolerante a fallos) y así una invitación
// no se rompe si el rol se recrea con otro id.
model Invitation {
  id             String    @id
  token          String    @unique
  invitationCode String?
  identifier     String?
  contextType    String
  contextId      String
  roleId         String?
  invitedBy      String
  invitedByUser  User      @relation(fields: [invitedBy], references: [id], onDelete: Cascade)
  status         String    @default("pending")
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  acceptedAt     DateTime?
  cancelledAt    DateTime?
  metadata       Json?

  @@index([contextType, contextId])
  @@index([identifier])
  @@index([roleId])
  @@map("invitation")
}

// ============================================================================
// Modelos propios de la app
// ============================================================================

// Lista de la compra de una familia (issue #65). La familia es la Organization
// del plugin de tenancy: la FK en cascada para que al borrar aquélla no queden
// listas huérfanas. `color` e `icon` guardan nombres, no estilos: la paleta es
// la semántica de daisyUI (LIST_COLORS) y el icono un nombre del set lucide
// (LIST_ICONS), ambos validados en `$lib/schemas/list`.
model List {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String
  icon           String
  items          Item[]
  purchases      PurchaseRecord[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@map("list")
}

// Item de una lista de la compra (issue #67). La FK a `list` es en cascada: al
// borrar la lista mueren sus items (el de familia ya cascada a las listas).
// `quantity` es Decimal — DECIMAL(10,3), hasta 9.999.999,999 — para no perder
// precisión a redondeos de coma flotante; la regla > 0 vive en
// `$lib/schemas/item`, junto al resto de validación del formulario. `unit` es
// el enum nativo `unit`: sus valores son identificadores estables en inglés y
// NUNCA se muestran tal cual — las etiquetas visibles las resuelve Paraglide
// (claves `unit_*` en `messages/{es,en}.json`). `purchased` parte de false y
// `order` fija la posición en la lista: lo calcula el servidor al crear, sin
// default para que nadie inserte sin decir dónde.
model Item {
  id        String   @id @default(cuid())
  listId    String
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  name      String
  quantity  Decimal  @db.Decimal(10, 3)
  unit      Unit
  purchased Boolean  @default(false)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listId])
  @@map("item")
}

// Unidades de un item (issue #67): ud, kg, g, L, ml, paquete, lata, docena.
// Los valores replican el catálogo UNITS de `$lib/schemas/item`; un spec
// garantiza que no se separan (validar y almacenar es el mismo contrato).
enum Unit {
  unit
  kilogram
  gram
  liter
  milliliter
  package
  can
  dozen

  @@map("unit")
}

// Registro histórico de una compra finalizada (issue #75): snapshot inmutable
// que crea la transacción de «finalizar compra» (#43). La familia es la dueña
// (Cascade, como las listas). La lista de origen es nullable con SetNull: el
// historial sobrevive a que se borre la lista, por eso el nombre va snapshotado
// en `listName`. `total` es DECIMAL(10,2) — euros con céntimos — y lo escribe a
// mano el usuario en el modal al finalizar (moneda única EUR, sin campo). La
// fecha de la compra es el `createdAt`: el registro se crea exactamente al
// finalizar, no tiene vida posterior (inmutable). El usuario que finaliza
// también va con SetNull: que borre su cuenta no debe romper el historial.
//
// El índice (familia, createdAt DESC, id) es el del listado del historial
// (issue #109): la consulta ordena por `createdAt desc, id desc` y filtra por
// familia, así que el `organizationId` suelto que había no le servía.
model PurchaseRecord {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listId         String?
  list           List?          @relation(fields: [listId], references: [id], onDelete: SetNull)
  listName       String
  total          Decimal        @db.Decimal(10, 2)
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          PurchaseItem[]
  createdAt      DateTime       @default(now())

  @@index([organizationId, createdAt(sort: Desc), id])
  @@map("purchaseRecord")
}

// Snapshot inmutable de cada item comprado (issue #75). Misma precisión que el
// `Item` de origen (DECIMAL(10,3), ver Item.quantity) y el mismo enum `unit`
// para que el snapshot conserve íntegro lo que sabía la lista.
//
// `position` congela el orden del item EN LA LISTA al comprar (issue #109):
// sin él, el orden del detalle dependía del orden de inserción físico, que
// Postgres no promete; ahora el detalle lee por `position` y sale SIEMPRE
// igual. Lo escribe `finalizePurchase` (nadie inserta sin decir dónde, como
// el `order` de Item).
model PurchaseItem {
  id               String         @id @default(cuid())
  purchaseRecordId String
  purchaseRecord   PurchaseRecord @relation(fields: [purchaseRecordId], references: [id], onDelete: Cascade)
  position         Int
  name             String
  quantity         Decimal        @db.Decimal(10, 3)
  unit             Unit

  @@index([purchaseRecordId])
  @@map("purchaseItem")
}

// Item de la despensa de la familia (issue #70): donde aterrizan los items
// comprados al finalizar una compra. La familia es la dueña (Cascade, como las
// listas). `name` es el nombre visible del item tal y como se escribió en la
// lista; `normalizedName` es el nombre CANÓNICO de búsqueda (trim, minúsculas
// y sin acentos, ver `normalizeItemName` en `$lib/server/purchases`) — no se
// muestra, existe para que «Leche Entera» y «leche entera» sean el mismo
// producto de la despensa. `quantity` se acumula: cada compra suma sobre lo que
// ya había, con la misma precisión que el `Item` de origen (DECIMAL(10,3)) y el
// mismo enum `unit`.
//
// El único (familia, nombre normalizado, unidad) ES el contrato de «mismo
// producto»: convierte la suma en un upsert atómico (INSERT ON CONFLICT de
// Postgres, dos compras concurrentes nunca lo parten) y sirve de índice para
// las consultas de la familia — con `organizationId` delante, la propia
// restricción indexa el listado de la despensa.
model PantryItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  quantity       Decimal      @db.Decimal(10, 3)
  unit           Unit
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, normalizedName, unit])
  @@map("pantryItem")
}
