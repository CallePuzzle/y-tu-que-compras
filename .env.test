# Entorno de los tests E2E (Playwright). Sin secretos reales: solo apunta al
# PostgreSQL de docker-compose.yml (puerto 55433) y fija valores dummy para el
# resto. El servidor de los e2e es `vite dev`, así que no sale ningún email
# real (quedan capturados en el log) y better-auth no activa el rate limit.
DATABASE_URL=postgresql://test:test@localhost:55433/e2e
BETTER_AUTH_SECRET=e2e-test-secret-no-usar-en-produccion-0123456789abcdef
BETTER_AUTH_URL=http://localhost:4174
SMTP_HOST=
SMPT_AUTH_USER=
SMPT_AUTH_PASS=
SMPT_SENDER=
