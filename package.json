{
	"name": "y-tu-que-compras",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "svelte-kit sync && prisma generate && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "prisma db push",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:status": "prisma migrate status",
		"db:studio": "prisma studio",
		"db:test:up": "docker compose up -d postgres-test",
		"db:test:down": "docker compose stop postgres-test",
		"test:unit": "vitest --project client --project server",
		"test:integration": "vitest --run --project integration",
		"test": "bun run test:unit -- --run && bun run test:integration && bun run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium",
		"audit": "bun audit --audit-level=moderate --ignore=GHSA-ggr8-5vv4-36mx"
	},
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=24",
		"bun": ">=1.4.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@floating-ui/core": "^1.8.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-vercel": "6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/nodemailer": "^8.0.1",
		"@vitest/browser-playwright": "^4.1.12",
		"daisyui": "^5.7.50",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"pino-pretty": "^13.2.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@callepuzzle/auth": "^1.0.2",
		"@callepuzzle/core": "^1.0.0",
		"@callepuzzle/svelte-ui": "^1.1.2",
		"@lucide/svelte": "^1.57.0",
		"@opentelemetry/api": "^1.9.1",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@sjmc11/tourguidejs": "^0.0.27",
		"@vercel/otel": "^2.1.3",
		"@zytera/better-auth-tenancy": "^3.2.2",
		"better-auth": "^1.7.10",
		"bits-ui": "^2.19.0",
		"dotenv": "^18.0.8",
		"nodemailer": "^10.2.1",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"prisma": "^7.10.0",
		"sveltekit-superforms": "^2.31.0",
		"zod": "^4.6.7"
	},
	"trustedDependencies": [
		"@prisma/engines",
		"prisma"
	],
	"overrides": {
		"formsnap": {
			"svelte-toolbelt": "^0.10.6"
		},
		"mysql2": "^3.24.6"
	}
}
